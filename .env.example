# Primary LLM (OpenRouter); models are tried in order. Gemini below is the backup.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m3.1-flash:free
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GROUNDING_THRESHOLD=0.30
TOP_K=6
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Optional, not used by CodeLens yet
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
